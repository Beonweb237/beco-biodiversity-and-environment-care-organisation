# ============================================================
# BECO — Configuration (copiez ce fichier en `.env`)
# ============================================================

# --- Supabase -------------------------------------------------
# URL de votre projet Supabase (Dashboard > Settings > API)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé publique (anon)
SUPABASE_ANON_KEY=votre-cles-anon
# Clé service_role — RÉSERVÉE AU SERVEUR Express, ne jamais exposer
SUPABASE_SERVICE_ROLE_KEY=votre-cles-service-role
# Bucket Supabase Storage pour les images uploadées (panneau admin)
SUPABASE_BUCKET=beco-images

# --- Auth admin (JWT) -----------------------------------------
# Secret utilisé pour signer les tokens du panneau d'administration.
# Changez cette valeur ! Générez-en une avec : openssl rand -hex 32
ADMIN_JWT_SECRET=changez-moi-secret-tres-long

# --- Serveur --------------------------------------------------
# Port de l'API Express (Vite tourne sur 3000 et proxifie /api vers 3001)
PORT=3001
NODE_ENV=development

# Dossier de stockage des images uploadées (panneau admin)
UPLOADS_DIR=public/uploads
# Préfixe public des fichiers uploadés (ex: https://beco.org)
PUBLIC_URL_PREFIX=

# URL du site (utilisée pour le CORS en production)
SITE_URL=http://localhost:3000
